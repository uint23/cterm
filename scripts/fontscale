#!/bin/sh
set -eu

DIR="$HOME/.local/share/fonts"
FONT="$DIR/FONT.ttf"
BDF="$DIR/FONT.bdf"
META="$DIR/fontscale"
DPI=96

[ "$#" -eq 1 ] || {
	echo "Usage: fontscale {+|-}" >&2
	exit 1
}

[ -f "$FONT" ] || {
	echo "Font not found: $FONT" >&2
	exit 1
}

[ -f "$META" ] || {
	echo "Scale file not found: $META" >&2
	exit 1
}

scale=$(cat "$META")

case "$scale" in
	''|*[!0-9]*)
		echo "Invalid scale in $META: $scale" >&2
		exit 1
		;;
esac

case "$1" in
	+)
		scale=$((scale + 1))
		;;
	-)
		[ "$scale" -gt 1 ] || {
			echo "Scale cannot be less than 1" >&2
			exit 1
		}
		scale=$((scale - 1))
		;;
	*)
		echo "Usage: fontscale [+|-]" >&2
		exit 1
		;;
esac

otf2bdf -n -p "$scale" -r "$DPI" -o "$BDF" "$FONT"
printf '%s\n' "$scale" >"$META"

