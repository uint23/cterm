#!/bin/sh

for arg do
	case "$arg" in
		--help)
			echo "Usage: ./configure [x11|wayland|mac]"
			exit 0
			;;
		*)
			if [ -n "$backend" ]; then
				echo "Usage: ./configure [x11|wayland|mac]"
				exit 1
			fi
			backend="$arg"
			;;
	esac
done

cat > config.mk << EOF
# Generated by configure script
BACKEND = $backend
EOF

case "$backend" in
	x11)
		echo "CONF_CPPFLAGS = -DBACKEND_X11" >> config.mk
		echo "CONF_LDFLAGS = -lX11 -lXext" >> config.mk
		echo "CONF_SRC = source/maus_x11.c" >> config.mk
		echo "CONF_OBJS = build/maus_x11.o" >> config.mk
		echo "CONF_LIB_NAME = libmaus_x11.a" >> config.mk
		;;
	wayland)
		echo "CONF_CPPFLAGS = -DBACKEND_WAY $(pkg-config --cflags wayland-client wayland-cursor xkbcommon)" >> config.mk
		echo "CONF_LDFLAGS = $(pkg-config --libs wayland-client wayland-cursor xkbcommon)" >> config.mk
		echo "CONF_SRC = source/maus_wayland.c build/xdg-shell-protocol.c build/pointer-constraints-unstable-v1-protocol.c build/relative-pointer-unstable-v1-protocol.c" >> config.mk
		echo "CONF_OBJS = build/maus_wayland.o build/xdg-shell-protocol.o build/pointer-constraints-unstable-v1-protocol.o build/relative-pointer-unstable-v1-protocol.o" >> config.mk
		echo "CONF_LIB_NAME = libmaus_wayland.a" >> config.mk
		echo "PROTOS = $(pkg-config --variable=pkgdatadir wayland-protocols)" >> config.mk
		;;
	mac)
		# TODO
		;;
	*)
		echo "Unsupported backend '$backend'"
		rm -f config.mk
		exit 1
		;;
esac
echo "Configuration done"

