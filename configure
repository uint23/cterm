#!/bin/sh
set -eu

PLATFORM=$(uname -s)
BACKEND=${1:-}
CPPFLAGS=
LDFLAGS="-Llibmaus/build"
LDLIBS=

if [ "$#" -gt 1 ]; then
	echo "Usage: ./configure [x11|wayland|mac]" >&2
	exit 1
fi

case "$PLATFORM" in
	Darwin)
		: "${BACKEND:=mac}"
		;;
	Linux|FreeBSD|OpenBSD)
		if [ -z "$BACKEND" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
			BACKEND=wayland
		elif [ -z "$BACKEND" ] && [ -n "${DISPLAY:-}" ]; then
			BACKEND=x11
		elif [ -z "$BACKEND" ]; then
			echo "No X11 or Wayland display found" >&2
			exit 1
		fi
		;;
	*)
		echo "Unsupported platform: $PLATFORM" >&2
		exit 1
		;;
esac

case "$PLATFORM" in
	Linux)
		CPPFLAGS="-D_XOPEN_SOURCE=700"
		;;
	FreeBSD)
		LDLIBS="-lutil"
		;;
	OpenBSD)
		CPPFLAGS="-I/usr/X11R6/include"
		LDFLAGS="-L/usr/X11R6/lib $LDFLAGS"
		LDLIBS="-lutil"
		;;esac

(
	cd libmaus
	rm -rf build/
	./configure "$BACKEND"
	make
)

CONF_CPPFLAGS=$(sed -n 's/^CONF_CPPFLAGS = //p' libmaus/config.mk)
CONF_LDFLAGS=$(sed -n 's/^CONF_LDFLAGS = //p' libmaus/config.mk)
CONF_LIB_NAME=$(sed -n 's/^CONF_LIB_NAME = //p' libmaus/config.mk)
CONF_LIB=${CONF_LIB_NAME#lib}
CONF_LIB=${CONF_LIB%.a}

cat >platform.mk <<EOF
CPPFLAGS += $CPPFLAGS $CONF_CPPFLAGS
LDFLAGS += $LDFLAGS
LDLIBS += -l$CONF_LIB
LDLIBS += ${CONF_LDFLAGS} $LDLIBS
EOF

echo "Configuration done"

