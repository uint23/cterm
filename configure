#!/bin/sh
set -eu

PLATFORM=$(uname -s)
CPPFLAGS=
LDFLAGS="-Llibmaus/build"

case "$PLATFORM" in
	Darwin)
		BACKEND=mac
		LDLIBS="-lmaus_mac \
		        -framework Cocoa \
		        -framework CoreVideo \
		        -framework IOKit \
		        -framework CoreGraphics \
		        -framework CoreFoundation \
		        -framework Carbon"
		;;

	Linux|FreeBSD|OpenBSD)
		if [ -n "${WAYLAND_DISPLAY:-}" ]; then
			BACKEND=way
			CPPFLAGS=-DBACKEND_WAY
			LDLIBS="-lmaus_way -lwayland-client"
		elif [ -n "${DISPLAY:-}" ]; then
			BACKEND=x11
			CPPFLAGS=-DBACKEND_X11
			LDLIBS="-lmaus_x11 -lX11 -lXext"
		else
			echo "No X11 or Wayland display found" >&2
			exit 1
		fi

		case "$PLATFORM" in
			Linux)
				CPPFLAGS="-D_XOPEN_SOURCE=700 $CPPFLAGS"
				;;
			OpenBSD)
				CPPFLAGS="-I/usr/X11R6/include $CPPFLAGS"
				LDFLAGS="-L/usr/X11R6/lib $LDFLAGS"
				;;
		esac
		;;

	*)
		echo "Unsupported platform: $PLATFORM" >&2
		exit 1
		;;
esac

(
	cd libmaus
	rm -rf build/
	./configure --backend="$BACKEND"
	make
)

cat >platform.mk <<EOF
CPPFLAGS += $CPPFLAGS
LDFLAGS += $LDFLAGS
LDLIBS += $LDLIBS
EOF

echo "Configuration done"
