#!/bin/sh

PLATFORM=$(uname)

if [ -n "$WAYLAND_DISPLAY" ]; then
	UNIX_BACKEND=-DBACKEND_WAY
elif [ -n "$DISPLAY" ]; then
	UNIX_BACKEND=-DBACKEND_X11
else
	echo "Neither Xorg or Wayland detected! Aborting..." >&2
	exit 1
fi

LINUX_LDFLAGS="-lX11 -lXext"
LINUX_CPPFLAGS="-D_XOPEN_SOURCE=700 $UNIX_BACKEND"

FREEBSD_LDFLAGS="-lX11 -lXext"
FREEBSD_CPPFLAGS="$UNIX_BACKEND"

OPENBSD_LDFLAGS="-I/usr/X11R6/include -L/usr/X11R6/lib -lX11 -lXext"
OPENBSD_CPPFLAGS="$UNIX_BACKEND"

MACOS_LDFLAGS="-framework Cocoa -framework CoreVideo -framework IOKit -framework CoreGraphics -framework CoreFoundation -framework Carbon"

{
	case "$PLATFORM" in
		Linux)
			echo "# Linux"
			echo "LDFLAGS += $LINUX_LDFLAGS"
			echo "CPPFLAGS += $LINUX_CPPFLAGS"
			;;
		FreeBSD)
			echo "# FreeBSD"
			echo "LDFLAGS += $FREEBSD_LDFLAGS"
			echo "CPPFLAGS += $FREEBSD_CPPFLAGS"
			;;
		OpenBSD)
			echo "# OpenBSD"
			echo "LDFLAGS += $OPENBSD_LDFLAGS"
			echo "CPPFLAGS += $OPENBSD_CPPFLAGS"
			;;
		Darwin)
			echo "# Darwin"
			echo "LDFLAGS += $MACOS_LDFLAGS"
			;;
		*) # TODO: some better default option
			echo "Unsupported platform: $PLATFORM" >&2
			exit 1
			;;
	esac
} > platform.mk
